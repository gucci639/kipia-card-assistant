# ==============================================================================
# Конфигурация LLM API (поддерживаются OpenAI, OpenRouter, Google Gemini, Ollama)
# Скопируйте этот файл в .env и укажите ваш API-ключ:
#   cp .env.example .env
# ==============================================================================

# Ключ API провайдера (обязателен для облачных моделей; для Ollama укажите "ollama")
LLM_API_KEY=your_api_key_here

# Базовый URL OpenAI-совместимого API:
# - OpenAI:      https://api.openai.com/v1
# - OpenRouter:  https://openrouter.ai/api/v1
# - Google:      https://generativelanguage.googleapis.com/v1beta/openai/
# - Ollama:      http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Имя модели (например: gpt-4o-mini, anthropic/claude-sonnet-4.6, google/gemini-3.6-flash)
LLM_MODEL=gpt-4o-mini

# Параметры генерации и таймаут
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# Ссылка на YML-фид каталога КИПиА (по умолчанию Союз-Прибор)
YML_FEED_URL=https://www.souz-pribor.ru/yml/any/feed.xml
